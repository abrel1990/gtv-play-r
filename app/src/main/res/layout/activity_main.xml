<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000">

        <View
            android:id="@+id/btn_shield"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"
            android:clickable="true"
            android:focusable="false" />

        <FrameLayout
            android:id="@+id/rot_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:surface_type="none"
                app:resize_mode="fit"
                android:keepScreenOn="true" />

            <TextView
                android:id="@+id/exo_loader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/loader_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:minWidth="130dp"
                android:gravity="center"
                android:text="Sintonizando..."
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/info_canal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/info_canal_bg"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/logo_canal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/nombre_canal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Canal"
                    android:textColor="#FFD700"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/numero_canal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0/0"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="44dp"
                android:layout_height="60dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="20dp"
                android:background="@drawable/nav_btn_bg"
                android:text="❮"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="44dp"
                android:layout_height="60dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="20dp"
                android:background="@drawable/nav_btn_bg"
                android:text="❯"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/btn_close_bg"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_rotate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="64dp"
                android:background="@drawable/btn_rotate_bg"
                android:text="⟳"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null" />
        </FrameLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
