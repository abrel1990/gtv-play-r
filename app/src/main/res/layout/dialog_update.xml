<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#111111"
    android:padding="32dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎉 Nueva versión disponible"
        android:textColor="#FFD700"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Actualización de GTV Play"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/dialogVersionActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Versión actual: 0.0.0"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/dialogVersionNueva"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nueva versión: 0.0.0"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/dialogMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Podés actualizar ahora o más tarde."
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/dialogBtnActualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="Actualizar ahora"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/dialog_btn_primary_bg"
        android:layout_marginBottom="14dp"
        android:focusable="true"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/dialogBtnMasTarde"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="Más tarde"
        android:textColor="#FFD700"
        android:textSize="16sp"
        android:background="@drawable/dialog_btn_secondary_bg"
        android:focusable="true"
        android:stateListAnimator="@null" />

</LinearLayout>
