<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#141414"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉 Nueva versión disponible"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/dialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actualización de GTV Play R"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/dialogVersionActual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Versión actual: 1.0"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/dialogVersionNueva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nueva versión: 1.1"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/dialogMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#DDDDDD"
        android:textSize="13sp"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/dialogBtnMasTarde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Más tarde"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333" />

        <Button
            android:id="@+id/dialogBtnActualizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar"
            android:textColor="#000000"
            android:backgroundTint="#FFD700"
            android:layout_marginStart="10dp" />
    </LinearLayout>
</LinearLayout>
